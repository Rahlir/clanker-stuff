{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true
  },
  "include": ["lib/**/*.ts", "extensions/**/*.ts"],
  "exclude": ["node_modules", "extensions/code-review"]
}
