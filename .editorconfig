root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.ts]
indent_style = space
indent_size = 2

[*.json]
indent_style = space
indent_size = 2

# Trailing spaces are significant in Markdown (forced line breaks)
[*.md]
trim_trailing_whitespace = false
